is_mac() { [[ $OSTYPE == darwin* ]] }

# Clipboard / open, so the same aliases work on WSL and macOS.
if is_mac; then
  alias open-here='open .'
  copy() { pbcopy }
else
  open() { explorer.exe "$(wslpath -w "${1:-.}")" 2>/dev/null || true }
  copy() { clip.exe }
fi

alias v='nvim'
alias c='clear'
alias cat='bat --paging=never'
alias ls='eza --group-directories-first --icons=auto'
alias ll='eza -l --group-directories-first --icons=auto --git'
alias la='eza -la --group-directories-first --icons=auto --git'
alias lt='eza --tree --level=2 --icons=auto --git-ignore'
alias du-sorted='du -sh * | sort -hr'
alias ghi='history 1 | grep'
alias lg='lazygit'
alias zrc='nvim $ZDOTDIR/.zshrc -c "e $ZDOTDIR/.zsh_aliases" -c "bp"; exec zsh'
alias vrc='nvim ~/.config/nvim'
alias ..='cd ..'
alias ...='cd ../..'
alias {:q,:q!,:wq,:wq!,:Q}='exit'
alias cheat='~/dotfiles/bin/cheat.sh'
alias gho='gh browse'
alias o='open .'
alias gentoken="node -e 'console.log(require(\`crypto\`).randomBytes(256).toString(\`base64\`));' | copy"
alias update='source $ZDOTDIR/.zshrc'
alias code='nvim .'
alias work='pomodoro work 55m'
alias rest='pomodoro rest 5m'
alias lrest='pomodoro rest 10m'
is_mac && alias brewup='brew update; brew upgrade; brew cleanup; brew doctor'

# Kill whatever is listening on a TCP port: killport 5173
killport() {
  local pids
  pids=$(lsof -t -iTCP:"$1" -sTCP:LISTEN 2>/dev/null)
  if [[ -z $pids ]]; then
    echo "No process listening on port $1"
  else
    echo "Killing $pids (port $1)"
    kill -9 ${=pids}
  fi
}
alias findandkill=killport
