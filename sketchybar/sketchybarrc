#!/bin/zsh
# Floating Catppuccin pills, laid out like the Zebar bar on Windows:
#   left:   workspaces | layout badge | app + window title
#   center: date + time
#   right:  critter | Spotify | volume cpu mem net battery

source "$CONFIG_DIR/colors.sh"
source "$CONFIG_DIR/icons.sh"
ITEMS="$CONFIG_DIR/items"
export PLUGINS="$CONFIG_DIR/plugins"
export FONT="JetBrainsMono Nerd Font"

# The bar itself is invisible; each group draws its own pill.
sketchybar --bar height=44 \
                 color=$TRANSPARENT \
                 position=top \
                 sticky=on \
                 topmost=off \
                 y_offset=4 \
                 margin=10 \
                 padding_left=0 \
                 padding_right=0

sketchybar --default updates=when_shown \
                     icon.font="$FONT:Bold:15.0" \
                     label.font="$FONT:Bold:13.0" \
                     icon.color=$TEXT \
                     label.color=$TEXT \
                     padding_left=0 \
                     padding_right=0 \
                     icon.padding_left=6 \
                     icon.padding_right=4 \
                     label.padding_left=0 \
                     label.padding_right=6

# pill <name> <member regex>: wrap items in the shared pill background
pill() {
  sketchybar --add bracket "$1" "$2" \
             --set "$1" background.color=$PILL_BG \
                        background.border_color=$PILL_BORDER \
                        background.border_width=1 \
                        background.corner_radius=12 \
                        background.height=34
}
# gap <name> <position>: 8px spacer between pills
gap() { sketchybar --add item "$1" "$2" --set "$1" width=8 icon.drawing=off label.drawing=off; }

source "$ITEMS/spaces.sh"
source "$ITEMS/mode.sh"
source "$ITEMS/front_app.sh"
source "$ITEMS/clock.sh"
source "$ITEMS/stats.sh"   # right items are added right-to-left
source "$ITEMS/media.sh"
source "$ITEMS/mascot.sh"

sketchybar --update
